<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:TheBleedingDeacons.Intergroup.Link.Views"
       x:Class="TheBleedingDeacons.Intergroup.Link.AppShell"
       Shell.FlyoutBehavior="Disabled"
       Title="Link">

	<!--
		The sign-in page is a ShellContent rather than a modal, and the
		tab bar below it is hidden until there is a session. A member who
		is not enrolled has nothing to look at in Messages and nothing to
		put in Compose, and offering them empty screens is a worse answer
		than not offering them.
	-->
	<ShellContent x:Name="SignIn"
	              Title="Sign in"
	              ContentTemplate="{DataTemplate views:SignInPage}"
	              Route="signin" />

	<!--
		Text-only tabs, and deliberately so rather than by omission.

		Messages carried Icon="ic_message.png", which does not exist and
		never did — no such file was ever added under Resources/Images. It
		failed the way a missing Android drawable always does: silently on
		screen, and loudly only in logcat, where Glide reported
		FileNotFoundException on every render. Settings never had one, so
		the tab bar looked intentional and the log was the only tell.

		Removed rather than replaced. Two text labels read perfectly well,
		and half an icon set is worse than none; adding real artwork is a
		design decision, not a fix for a broken reference. If icons are
		wanted later, both tabs get one in the same change.
	-->
	<TabBar x:Name="Tabs">
		<ShellContent Title="Messages"
		              ContentTemplate="{DataTemplate views:MessagesPage}"
		              Route="messages" />
		<ShellContent Title="Settings"
		              ContentTemplate="{DataTemplate views:SettingsPage}"
		              Route="settings" />
	</TabBar>

</Shell>
