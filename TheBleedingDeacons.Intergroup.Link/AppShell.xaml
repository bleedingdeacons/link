<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:TheBleedingDeacons.Intergroup.Link.Views"
       x:Class="TheBleedingDeacons.Intergroup.Link.AppShell"
       Shell.FlyoutBehavior="Disabled"
       Title="Link">

	<!--
		Two top-level routes and nothing else, which is Hand's shape.

		There used to be a tab bar here - Messages and Settings - and it
		was the most visible thing that made Link look like a different
		family from Hand. Hand has no tabs: the duty screen carries its
		own header with Settings in it, and Settings is a page you push,
		look at, and come back from. Link now does the same, from the
		message list's header, so a member holding both apps meets one
		way of getting about.

		With no tab bar and the flyout disabled there is nothing on screen
		that could offer the page a member is not meant to be on, so
		neither route needs hiding. Which one is showing is decided by
		AppShell.RefreshAsync.
	-->
	<ShellContent Route="signin"
	              ContentTemplate="{DataTemplate views:SignInPage}"
	              Shell.NavBarIsVisible="False" />

	<ShellContent Route="messages"
	              ContentTemplate="{DataTemplate views:MessagesPage}"
	              Shell.NavBarIsVisible="False" />

</Shell>
