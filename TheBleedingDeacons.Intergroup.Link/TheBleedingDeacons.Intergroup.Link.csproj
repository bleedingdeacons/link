<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!--
			<b>Two heads, and the iOS one is honestly partial.</b>

			Android was asked for first and the whole push path is built
			for it: a data-only FCM message the app wakes to and decrypts
			itself. The iOS head listed here does <i>not</i> have that. It
			has no Firebase iOS SDK, no APNs key and no background-fetch
			entitlement, so an iOS build collects its messages by polling —
			which is a documented, working state, the same one an Android
			build without google-services.json is in, and the same one a
			phone in a tunnel is in. It is not a broken app; it is a slower
			one. `Platforms/iOS/PushRegistrar.ios.cs` says so at the point
			where the difference lives.

			Sign in with Apple is the sharper gap: `DeviceAuthService` and
			Fellowship both have the path, but nothing on this side raises
			the platform sheet to get the token it needs, so an iOS member
			signs in with Google. That works — WebAuthenticator and the
			`link` URL scheme are wired in Info.plist below.

			This file previously carried TargetFramework *singular* and an
			argument for why: listing the TFM before the work was done
			would produce a head that compiles and does not work. The
			answer to that objection is that it compiles and does work, at
			polling speed, and the alternative was an iOS build nobody
			could produce at all. See README.md, "What is not done", which
			now states the gap rather than the absence.

			<b>The default is host-aware, and the line is Linux, not
			Windows.</b> Windows has a real iOS toolchain: it compiles the
			managed half unaided, and Visual Studio's iOS Hot Restart
			deploys a Debug build to a tethered iPhone using a free Apple
			ID and no Mac at all. What Windows cannot do is produce the
			.app bundle — the native link and the asset catalog need one.
			Linux has nothing; there is no maui-ios workload for it.

			This briefly excluded Windows too, on the reasoning that only
			macOS can build an iOS head. That is true of the *artifact* and
			false of everything else, and it had a consequence worth
			recording: with the TFM absent on Windows, Visual Studio could
			not see the iOS head at all, so Hot Restart had nothing to
			offer and the one route from this machine to an iPhone was
			closed by a condition meant to be conservative.

			The cost is that a bare `dotnet build` on Windows now builds
			both heads. Pass LinkAndroidOnly for the Android-only loop —
			/kick does, and the README's build command always did.

			Order matters below — the last matching condition wins, so an
			explicit narrowing property beats the host default. `-f` is
			still forbidden: it sets TargetFramework globally and forces
			the TFM onto Link.Core, breaking its restore with NU1105.
		-->
		<TargetFrameworks>net10.0-android;net10.0-ios</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('Linux'))">net10.0-android</TargetFrameworks>
		<TargetFrameworks Condition="'$(LinkAndroidOnly)' == 'true'">net10.0-android</TargetFrameworks>
		<TargetFrameworks Condition="'$(LinkIosOnly)' == 'true'">net10.0-ios</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>TheBleedingDeacons.Intergroup.Link</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!--
			Compile XAML bindings that set Source, and fail the build when one
			cannot be compiled. Hand carries both lines; this project had neither,
			and it matters more here than there because this one has an iOS head.

			Without the property, a {Binding ... Source=...} silently falls back to
			reflection. Three files here set Source - App.xaml, ComposePage.xaml
			and MessagesPage.xaml - so the fallback was real rather than
			hypothetical. Reflection is slower everywhere, and under the full
			trimming an iOS Release build uses it is not safe at all: the member
			it reflects over can have been trimmed away, and the failure is a
			binding that quietly resolves to nothing on a device, with nothing
			wrong at compile time.

			The property alone only makes compilation possible. XC0022-XC0025 and
			XC0045 are the diagnostics the XAML compiler raises when it cannot
			compile a binding and falls back; left as warnings they scroll past in
			a build that says "succeeded". Escalated, they are a gate.
		-->
		<MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>
		<WarningsAsErrors>$(WarningsAsErrors);XC0022;XC0023;XC0024;XC0025;XC0045</WarningsAsErrors>

		<ApplicationTitle>Link</ApplicationTitle>
		<ApplicationId>com.thebleedingdeacons.intergroup.link</ApplicationId>
		<ApplicationDisplayVersion>1.4.1</ApplicationDisplayVersion>
		<ApplicationVersion>10</ApplicationVersion>

		<!--
			Derive the assembly versions from the display version rather than
			leaving them at the SDK default of 1.0.0.0, which is what they were:
			the app displayed 1.4.0 and every assembly in it claimed 1.0.0.0.
			That is the drift Hand hit, where the Windows head stamped the wrong
			version onto every log event, and one number to bump is the fix. The
			trailing .0 makes the four-part version out of the three-part display
			string, so keep ApplicationDisplayVersion three-part.

			bump-version.sh rewrites ApplicationDisplayVersion alone, so these
			follow a release without the script needing to know they exist.
		-->
		<AssemblyVersion>$(ApplicationDisplayVersion).0</AssemblyVersion>
		<FileVersion>$(ApplicationDisplayVersion).0</FileVersion>

		<!--
			When this build was made, to the second, stamped at build time.

			InformationalVersion is the only one of the three that can hold it:
			AssemblyVersion and FileVersion are four 16-bit fields capped at 65534
			each, and a yyyyMMddHHmmss stamp is about 202 billion. Stamped UTC so
			builds either side of a BST change still sort honestly.

			IncludeSourceRevisionInInformationalVersion is off because the SDK
			would otherwise append '+<commit sha>' and the result would carry two
			'+' segments, which anything parsing on the first one reads wrongly.
		-->
		<BuildTimestampUtc>$([System.DateTime]::UtcNow.ToString("yyyyMMddHHmmss"))</BuildTimestampUtc>
		<InformationalVersion>$(ApplicationDisplayVersion)+$(BuildTimestampUtc)</InformationalVersion>
		<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<!--
		Ship one ABI on Release. The Android SDK defaults RuntimeIdentifiers
		to arm64 plus x64, which nearly doubles the APK for an emulator
		architecture no member's phone runs. Override on the command line
		when an x64 emulator build is actually wanted.
	-->
	<PropertyGroup Condition="'$(Configuration)' == 'Release' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>
		<AndroidPackageFormat>apk</AndroidPackageFormat>
	</PropertyGroup>

	<!--
		Sign in with Apple, off by default.

		<b>The entitlement is the whole reason this is a switch.</b>
		com.apple.developer.applesignin is only grantable to a paid Apple
		Developer Program team. A free personal team — which is what signs
		a sideloaded build, and currently the only way Link reaches an
		iPhone at all — cannot sign an app that requests it, and the
		install fails outright rather than degrading. So asking for it
		unconditionally would trade a working sideload for a feature that
		still would not work.

		LINK_APPLE_SIGNIN also decides whether AppleSignIn reports itself
		available, so the button is absent from a build that could not
		honour it rather than present and permanently broken. The two must
		move together, which is why one property sets both.
	-->
	<PropertyGroup Condition="'$(LinkAppleSignIn)' == 'true' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
		<CodesignEntitlements>Platforms\iOS\Entitlements.plist</CodesignEntitlements>
		<DefineConstants>$(DefineConstants);LINK_APPLE_SIGNIN</DefineConstants>
	</PropertyGroup>

	<!--
		Unsigned device builds, for CI.

		An .ipa that anybody can install needs an Apple Developer Program
		membership, a distribution certificate and a provisioning profile.
		There is none, so CI archives an unsigned build: a real compile
		gate and a real artifact, which installs on nothing until it is
		re-signed. Switching it on later means supplying a certificate and
		profile to the build, not rearranging it.

		Set by the CI job rather than defaulted here, so a local macOS
		build with a real signing identity is unaffected.
	-->
	<PropertyGroup Condition="'$(LinkUnsigned)' == 'true'">
		<EnableCodeSigning>false</EnableCodeSigning>
		<CodesignKey></CodesignKey>
		<CodesignProvision></CodesignProvision>
		<DisableCodesignVerification>true</DisableCodesignVerification>
	</PropertyGroup>

	<ItemGroup>
		<MauiXaml Update="**\*.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
	</ItemGroup>

	<ItemGroup>
		<!-- The suite's green, not Hand's alert red: Link is the quiet one. -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" ForegroundScale="0.65" Color="#2E5E4E" />
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#2E5E4E" BaseSize="128,128" />
		<MauiImage Include="Resources\Images\*" />
		<MauiFont Include="Resources\Fonts\*" />
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<!--
			appsettings.json says which intergroup this build talks to.
			Embedded rather than copied, so it cannot be edited on a device
			to point the app at somebody else's server.

			<b>Conditional, and git-ignored, and that is not a convenience.</b>
			This is the production settings file — the place a credential
			naturally gets typed. Hand tracked its equivalent on the
			reasoning that the committed copy held nothing secret, which was
			true of the file at that moment and wrong about it over time: the
			first person to configure the app for real put a Better Stack
			token in it and the next `git add -A` published it. A file that
			is safe to commit today and is also where secrets get typed is
			not safe to commit.

			So the build must not require it. LinkServices answers an
			unconfigured object when the resource is absent and the sign-in
			screen says the app has not been set up — which is exactly what
			CI builds, and what proved this was unconditional in the first
			place.

			appsettings.example.json is tracked instead: same shape, no
			values.
		-->
		<EmbeddedResource Include="appsettings.json" LogicalName="appsettings.json" Condition="Exists('appsettings.json')" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.90" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.11" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.11" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.11" />
		<PackageReference Include="Serilog" Version="4.4.0" />
		<PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
		<PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
		<PackageReference Include="CommunityToolkit.Maui" Version="15.0.0" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="SonarAnalyzer.CSharp" Version="10.32.0.713">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<!--
		Firebase Cloud Messaging, Android only. This is what wakes the app
		for a message it then decrypts itself; see
		LinkFirebaseMessagingService.
	-->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<PackageReference Include="Xamarin.Firebase.Messaging" Version="125.1.1" />

		<!--
			The Firebase project this build registers with.

			<b>Conditional on its own existence, deliberately.</b> The file
			carries a project's API key and is not committed to a public
			repository, so a checkout without it must still build — CI has
			no business depending on a file it cannot have.

			A build without it produces an app that never receives a push.
			That is a degraded app, not a broken one: every message is
			collected on the next poll, which is the same guarantee Link
			gives a phone in a tunnel. Failing the build instead would
			trade a real, documented limitation for an imaginary one.
		-->
		<GoogleServicesJson Include="Platforms\Android\google-services.json" Condition="Exists('Platforms\Android\google-services.json')" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\TheBleedingDeacons.Intergroup.Link.Core\TheBleedingDeacons.Intergroup.Link.Core.csproj" />
	</ItemGroup>

</Project>
