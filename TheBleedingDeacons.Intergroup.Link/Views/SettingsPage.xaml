<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TheBleedingDeacons.Intergroup.Link.ViewModels"
             x:Class="TheBleedingDeacons.Intergroup.Link.Views.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Title="Settings">

	<ScrollView>
		<VerticalStackLayout Padding="16" Spacing="18">

			<Border Style="{StaticResource Card}" StrokeShape="RoundRectangle 10">
				<VerticalStackLayout Spacing="4">
					<Label Text="Signed in as" Style="{StaticResource Secondary}" />
					<Label Text="{Binding MemberName}" FontSize="18" />
				</VerticalStackLayout>
			</Border>

			<!--
				Whether push is available in this build and enabled on this
				phone. A dot and a headline, with the detail underneath.

				Second on the page on purpose: it sits directly above
				"Messages on this phone", which is where somebody goes when
				they think a message is missing. It is usually not missing —
				it is late, because nothing is being pushed — and this is
				the card that says so before they clear their history
				looking for it.

				The colour is the indicator at a glance: green working,
				amber still covered by the sync, red silenced, grey no push
				in this build at all. See PushStatus.
			-->
			<Border Style="{StaticResource Card}" StrokeShape="RoundRectangle 10">
				<VerticalStackLayout Spacing="6">
					<HorizontalStackLayout Spacing="8">
						<BoxView WidthRequest="12"
						         HeightRequest="12"
						         CornerRadius="6"
						         VerticalOptions="Center"
						         BackgroundColor="{Binding PushIndicatorColour}" />
						<Label Text="{Binding PushHeadline}" VerticalOptions="Center" />
					</HorizontalStackLayout>
					<Label Style="{StaticResource Secondary}" Text="{Binding PushDetail}" />
				</VerticalStackLayout>
			</Border>

			<Border Style="{StaticResource Card}" StrokeShape="RoundRectangle 10">
				<VerticalStackLayout Spacing="8">
					<Label Text="Messages on this phone" />
					<Label Style="{StaticResource Secondary}"
					       Text="{Binding Held, StringFormat='{0} kept on this handset, encrypted.'}" />
					<!--
						The wording matters. "Clear history" reads to most
						people as "delete the messages", and it is not that.
						The confirmation says so too.
					-->
					<Label Style="{StaticResource Secondary}"
					       Text="Clearing removes only this phone's copies. Nothing is unsent, and recent messages come back on the next sync." />
					<Button Text="Clear messages on this phone"
					        Style="{StaticResource Quiet}"
					        Command="{Binding ClearHistoryCommand}" />
				</VerticalStackLayout>
			</Border>

			<Border Style="{StaticResource Card}" StrokeShape="RoundRectangle 10">
				<VerticalStackLayout Spacing="8">
					<Label Text="Messages will not open?" />
					<Label Style="{StaticResource Secondary}"
					       Text="This can happen after a phone is restored from a backup, or after the screen lock changes. Getting a new key fixes messages sent from now on." />
					<Button Text="Fix messages that will not open"
					        Style="{StaticResource Quiet}"
					        Command="{Binding ReplaceKeyCommand}" />
				</VerticalStackLayout>
			</Border>

			<Button Text="Sign out" Command="{Binding SignOutCommand}" />

			<ActivityIndicator IsRunning="{Binding Busy}" IsVisible="{Binding Busy}" />

			<Label Text="{Binding Notice}"
			       IsVisible="{Binding HasNotice}"
			       Style="{StaticResource Secondary}" />

			<!--
				The build, last and quiet, exactly as Hand shows it. It is the
				first thing asked for when a handset misbehaves, and the last
				thing anybody wants to read otherwise.
			-->
			<Label Text="{Binding Build}"
			       Margin="0,16,0,0"
			       FontSize="11"
			       Opacity="0.5"
			       HorizontalOptions="Center" />

		</VerticalStackLayout>
	</ScrollView>

</ContentPage>
