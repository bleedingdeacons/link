<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TheBleedingDeacons.Intergroup.Link.ViewModels"
             x:Class="TheBleedingDeacons.Intergroup.Link.Views.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Title="Settings">

	<ScrollView>
		<VerticalStackLayout Padding="16" Spacing="18">

			<Border Style="{StaticResource Card}" StrokeShape="RoundRectangle 10">
				<VerticalStackLayout Spacing="4">
					<Label Text="Signed in as" Style="{StaticResource Secondary}" />
					<Label Text="{Binding MemberName}" FontSize="18" />
				</VerticalStackLayout>
			</Border>

			<!--
				Whether push is available in this build and enabled on this
				phone. A dot and a headline, with the detail underneath.

				Second on the page on purpose: it sits directly above
				"Messages on this phone", which is where somebody goes when
				they think a message is missing. It is usually not missing —
				it is late, because nothing is being pushed — and this is
				the card that says so before they clear their history
				looking for it.

				The colour is the indicator at a glance: green working,
				amber still covered by the sync, red silenced, grey no push
				in this build at all. See PushStatus.
			-->
			<Border Style="{StaticResource Card}" StrokeShape="RoundRectangle 10">
				<VerticalStackLayout Spacing="6">
					<HorizontalStackLayout Spacing="8">
						<BoxView WidthRequest="12"
						         HeightRequest="12"
						         CornerRadius="6"
						         VerticalOptions="Center"
						         BackgroundColor="{Binding PushIndicatorColour}" />
						<Label Text="{Binding PushHeadline}" VerticalOptions="Center" />
					</HorizontalStackLayout>
					<Label Style="{StaticResource Secondary}" Text="{Binding PushDetail}" />
				</VerticalStackLayout>
			</Border>

			<Border Style="{StaticResource Card}" StrokeShape="RoundRectangle 10">
				<VerticalStackLayout Spacing="8">
					<Label Text="Sound" />
					<!--
						The noise a message makes when it lands while Link is
						open. A message that arrives with the app closed is
						announced by the platform, with whatever tone the
						member has set for the app - that is theirs to
						configure and nothing here touches it.

						A fellowship phone sits in meetings, so somewhere to
						turn this off is not a nicety.
					-->
					<Grid ColumnDefinitions="*,Auto">
						<Label Grid.Column="0"
						       Style="{StaticResource Secondary}"
						       VerticalOptions="Center"
						       Text="Play a sound when a message arrives while Link is open." />
						<Switch Grid.Column="1"
						        IsToggled="{Binding SoundOn}"
						        VerticalOptions="Center" />
					</Grid>
				</VerticalStackLayout>
			</Border>

			<Border Style="{StaticResource Card}" StrokeShape="RoundRectangle 10">
				<VerticalStackLayout Spacing="8">
					<Label Text="Messages on this phone" />
					<Label Style="{StaticResource Secondary}"
					       Text="{Binding Held, StringFormat='{0} kept on this handset, encrypted.'}" />
					<!--
						The wording matters. "Clear history" reads to most
						people as "delete the messages", and it is not that.
						The confirmation says so too.
					-->
					<Label Style="{StaticResource Secondary}"
					       Text="Clearing removes only this phone's copies. Nothing is unsent, and the intergroup keeps its own record." />
					<Button Text="Clear messages on this phone"
					        Style="{StaticResource Quiet}"
					        Command="{Binding ClearHistoryCommand}" />
				</VerticalStackLayout>
			</Border>

			<!--
				Shown only while there is a fault to fix. The recovery asks
				a member to sign in again, and offering that permanently
				would put an alarming-looking repair in front of everybody
				for something the usual member never meets.
			-->
			<Border Style="{StaticResource Card}"
			        StrokeShape="RoundRectangle 10"
			        IsVisible="{Binding KeyFault}">
				<VerticalStackLayout Spacing="8">
					<Label Text="Messages will not open?" />
					<Label Style="{StaticResource Secondary}"
					       Text="This usually happens after the screen lock changes, or after a phone is restored or transferred. Getting a new key fixes it, and your messages arrive again on the next sync." />

					<Button Text="Fix messages that will not open"
					        IsVisible="{Binding NotReplacingKey}"
					        Style="{StaticResource Quiet}"
					        Command="{Binding StartKeyReplacementCommand}" />

					<!--
						The same choices the sign-in page offers, because
						this asks for the same proof. Fellowship refuses a
						key replacement on a device token alone: substituting
						the key is enough to have every message it still
						holds re-sealed to it.
					-->
					<VerticalStackLayout Spacing="8" IsVisible="{Binding ReplacingKey}">
						<Label Style="{StaticResource Secondary}"
						       Text="Sign in again to prove this phone is yours." />

						<Button Text="Continue with Google"
						        Style="{StaticResource Quiet}"
						        Command="{Binding ReplaceKeyWithProviderCommand}"
						        CommandParameter="google" />
						<Button Text="Continue with Microsoft"
						        Style="{StaticResource Quiet}"
						        Command="{Binding ReplaceKeyWithProviderCommand}"
						        CommandParameter="microsoft" />
						<Button Text="Continue with Apple"
						        Style="{StaticResource Quiet}"
						        IsVisible="{Binding IsAppleAvailable}"
						        Command="{Binding ReplaceKeyWithAppleCommand}" />

						<Entry Placeholder="Email address"
						       Keyboard="Email"
						       Text="{Binding KeyEmail}" />
						<Entry Placeholder="Password"
						       IsPassword="True"
						       Text="{Binding KeyPassword}" />
						<Button Text="Continue with a password"
						        Style="{StaticResource Quiet}"
						        Command="{Binding ReplaceKeyWithPasswordCommand}" />

						<Button Text="Cancel"
						        Style="{StaticResource Quiet}"
						        Command="{Binding CancelKeyReplacementCommand}" />
					</VerticalStackLayout>
				</VerticalStackLayout>
			</Border>

			<Button Text="Sign out" Command="{Binding SignOutCommand}" />

			<ActivityIndicator IsRunning="{Binding Busy}" IsVisible="{Binding Busy}" />

			<Label Text="{Binding Notice}"
			       IsVisible="{Binding HasNotice}"
			       Style="{StaticResource Secondary}" />

			<!--
				The build, last and quiet, exactly as Hand shows it. It is the
				first thing asked for when a handset misbehaves, and the last
				thing anybody wants to read otherwise.
			-->
			<Label Text="{Binding Build}"
			       Margin="0,16,0,0"
			       FontSize="11"
			       Opacity="0.5"
			       HorizontalOptions="Center" />

		</VerticalStackLayout>
	</ScrollView>

</ContentPage>
