<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:TheBleedingDeacons.Intergroup.Link.Models;assembly=TheBleedingDeacons.Intergroup.Link.Core"
             xmlns:vm="clr-namespace:TheBleedingDeacons.Intergroup.Link.ViewModels"
             x:Class="TheBleedingDeacons.Intergroup.Link.Views.ComposePage"
             x:DataType="vm:ComposeViewModel"
             Title="New message">

	<ScrollView>
		<VerticalStackLayout Padding="16" Spacing="14">

			<Label Style="{StaticResource Secondary}"
			       IsVisible="{Binding IsReply}"
			       Text="{Binding ReplyToSubject, StringFormat='Replying to: {0}'}" />

			<!--
				Committee first, and it clears the people below when it is
				set: Fellowship refuses a message addressed to both,
				because the recipient list that would produce cannot be
				explained back to whoever sent it.
			-->
			<VerticalStackLayout Spacing="6" IsVisible="{Binding CanSendToCommittee}">
				<Label Text="Committee" Style="{StaticResource Secondary}" />
				<Picker ItemsSource="{Binding Committees}"
				        ItemDisplayBinding="{Binding Name}"
				        SelectedItem="{Binding Committee}"
				        Title="No committee — choose people below" />
				<Label Style="{StaticResource Secondary}"
				       Text="A committee includes its sub-committees." />
			</VerticalStackLayout>

			<VerticalStackLayout Spacing="6">
				<Label Text="People" Style="{StaticResource Secondary}" />
				<CollectionView ItemsSource="{Binding People}"
				                SelectedItems="{Binding SelectedPeople}"
				                SelectionMode="Multiple"
				                HeightRequest="200">
					<CollectionView.EmptyView>
						<Label Style="{StaticResource Secondary}"
						       Text="No one to show. Pull the message list down to reconnect." />
					</CollectionView.EmptyView>
					<CollectionView.ItemTemplate>
						<DataTemplate x:DataType="models:DirectoryMember">
							<Grid Padding="10,8">
								<Label Text="{Binding Name}" />
							</Grid>
						</DataTemplate>
					</CollectionView.ItemTemplate>
				</CollectionView>
			</VerticalStackLayout>

			<Entry Placeholder="Subject" Text="{Binding Subject}" MaxLength="200" />

			<Editor Placeholder="Message"
			        Text="{Binding Body}"
			        MaxLength="2000"
			        AutoSize="TextChanges"
			        HeightRequest="160" />

			<Label Style="{StaticResource Secondary}"
			       Text="Messages are encrypted before they leave your phone and are not shown in notifications." />

			<Button Text="Send" Command="{Binding SendCommand}" />

			<ActivityIndicator IsRunning="{Binding Busy}" IsVisible="{Binding Busy}" />

			<Label Text="{Binding Error}"
			       IsVisible="{Binding HasError}"
			       TextColor="{StaticResource Warning}" />

		</VerticalStackLayout>
	</ScrollView>

</ContentPage>
