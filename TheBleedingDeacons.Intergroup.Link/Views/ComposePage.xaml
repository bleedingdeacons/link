<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:TheBleedingDeacons.Intergroup.Link.Models;assembly=TheBleedingDeacons.Intergroup.Link.Core"
             xmlns:vm="clr-namespace:TheBleedingDeacons.Intergroup.Link.ViewModels"
             x:Class="TheBleedingDeacons.Intergroup.Link.Views.ComposePage"
             x:DataType="vm:ComposeViewModel"
             Shell.TabBarIsVisible="False"
             Title="New message">

	<ScrollView>
		<VerticalStackLayout Padding="16" Spacing="14">

			<Label Style="{StaticResource Secondary}"
			       IsVisible="{Binding IsReply}"
			       Text="{Binding ReplyToSubject, StringFormat='Replying to: {0}'}" />

			<Label Text="Send to" FontAttributes="Bold" />

			<!--
				Hand's arrangement, and Hand's reasoning with it: one scope
				or the other, chosen before the list rather than inferred
				from what happens to be selected in two lists at once.

				Fellowship refuses a message addressed to both a committee
				and named people, because the recipient list that would
				produce cannot be explained back to whoever sent it. Two
				radios make that rule visible instead of leaving it as a
				400 somebody meets after typing.

				Bound one-way and set from the code-behind, exactly as
				Hand does it: a two-way IsChecked binding fights itself,
				because selecting one radio unchecks the other and each
				uncheck fires the same handler.
			-->
			<Grid ColumnDefinitions="*,*" ColumnSpacing="8">
				<RadioButton
					Grid.Column="0"
					Content="A member"
					GroupName="scope"
					IsChecked="{Binding IsMemberMode, Mode=OneWay}"
					CheckedChanged="OnMemberScopeChecked" />
				<!--
					Hidden rather than disabled when the site does not
					allow committee sends from the app. This is not a
					setting somebody can turn on from here — Fellowship
					sends no committees at all — so a greyed control would
					be offering something that does not exist.
				-->
				<RadioButton
					Grid.Column="1"
					Content="A committee"
					GroupName="scope"
					IsVisible="{Binding CanSendToCommittee}"
					IsChecked="{Binding IsCommitteeMode, Mode=OneWay}"
					CheckedChanged="OnCommitteeScopeChecked" />
			</Grid>

			<!-- Members -->
			<VerticalStackLayout Spacing="8" IsVisible="{Binding IsMemberMode}">
				<!--
					Filters the list already in hand rather than asking
					Fellowship again. Hand searches server-side because its
					member list is paged; Link is handed the whole address
					book in one response, so a round trip per keystroke
					would buy nothing and cost a request.
				-->
				<SearchBar
					Text="{Binding Search}"
					Placeholder="Search by name or group" />

				<CollectionView
					ItemsSource="{Binding People}"
					SelectedItem="{Binding SelectedPerson}"
					SelectionMode="Single"
					HeightRequest="240">
					<CollectionView.EmptyView>
						<Label Style="{StaticResource Secondary}"
						       Text="No one to show. Pull the message list down to reconnect." />
					</CollectionView.EmptyView>
					<CollectionView.ItemTemplate>
						<DataTemplate x:DataType="models:DirectoryMember">
							<!--
								Hand's two-line row, and Hand's reason for
								it: a rota has more than one Dave, and what
								tells them apart is the home group.

								Where Hand puts a "Show number" button and
								the numbers it fetches, this puts the
								member's standing and nothing else. Link is
								never told an email address or a telephone
								number - see Fellowship's DirectoryPresenter
								- so there is nothing here to reveal and no
								button to press.
							-->
							<VerticalStackLayout Padding="12,10" Spacing="2">
								<Label Text="{Binding Name}" FontSize="16" />

								<!--
									Hidden rather than blank when a member
									has no group and is not a GSR, so the
									row closes up instead of holding open a
									line with nothing in it. DirectoryMember
									composes the string, so the empty case
									has one answer rather than one per
									screen.
								-->
								<Label Text="{Binding Standing}"
								       IsVisible="{Binding HasStanding}"
								       FontSize="12"
								       Opacity="0.6" />
							</VerticalStackLayout>
						</DataTemplate>
					</CollectionView.ItemTemplate>
				</CollectionView>
			</VerticalStackLayout>

			<!-- Committees -->
			<VerticalStackLayout Spacing="8" IsVisible="{Binding IsCommitteeMode}">
				<CollectionView
					ItemsSource="{Binding Committees}"
					SelectedItem="{Binding Committee}"
					SelectionMode="Single"
					HeightRequest="240">
					<CollectionView.ItemTemplate>
						<DataTemplate x:DataType="models:DirectoryCommittee">
							<Grid Padding="12,10">
								<Label Text="{Binding Name}" FontSize="16" />
							</Grid>
						</DataTemplate>
					</CollectionView.ItemTemplate>
				</CollectionView>
				<Label Style="{StaticResource Secondary}"
				       Text="A committee includes its sub-committees." />
			</VerticalStackLayout>

			<Entry Placeholder="Subject" Text="{Binding Subject}" MaxLength="200" />

			<Editor Placeholder="Message"
			        Text="{Binding Body}"
			        MaxLength="2000"
			        AutoSize="TextChanges"
			        HeightRequest="160" />

			<Label Style="{StaticResource Secondary}"
			       Text="Messages are encrypted before they leave your phone and are not shown in notifications." />

			<Button Text="Send" Command="{Binding SendCommand}" />

			<ActivityIndicator IsRunning="{Binding Busy}" IsVisible="{Binding Busy}" />

			<Label Text="{Binding Error}"
			       IsVisible="{Binding HasError}"
			       TextColor="{StaticResource Warning}" />

		</VerticalStackLayout>
	</ScrollView>

</ContentPage>
