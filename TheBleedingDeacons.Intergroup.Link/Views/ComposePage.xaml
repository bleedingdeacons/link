<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:TheBleedingDeacons.Intergroup.Link.Models;assembly=TheBleedingDeacons.Intergroup.Link.Core"
             xmlns:vm="clr-namespace:TheBleedingDeacons.Intergroup.Link.ViewModels"
             x:Class="TheBleedingDeacons.Intergroup.Link.Views.ComposePage"
             x:DataType="vm:ComposeViewModel"
             x:Name="Page"
             Shell.TabBarIsVisible="False"
             Title="New message">

	<ScrollView>
		<VerticalStackLayout Padding="16" Spacing="14">

			<Label Style="{StaticResource Secondary}"
			       IsVisible="{Binding IsReply}"
			       Text="{Binding ReplyToSubject, StringFormat='Replying to: {0}'}" />

			<Label Text="Send to" FontAttributes="Bold" />

			<!--
				One list, not two behind a radio.

				The radio existed because Fellowship refused a message
				addressed to a committee and to named people at once, so the
				screen had to make the sender choose a scope before it could
				show them anything. That rule went on 2026-09-11: a message now
				carries any number of members and committees together, the
				server resolves the union, and somebody in both gets one copy.
				With the rule gone the question "which list is showing?" is one
				nobody should have to answer.

				Chosen recipients are chips above the list. Each carries its own
				×, because the alternative to removing one is starting the
				message again.
			-->
			<FlexLayout BindableLayout.ItemsSource="{Binding Chosen}"
			            IsVisible="{Binding HasChosen}"
			            Wrap="Wrap"
			            Direction="Row"
			            AlignItems="Start">
				<BindableLayout.ItemTemplate>
					<DataTemplate x:DataType="models:Recipient">
						<Border Margin="0,0,6,6"
						        Padding="10,4"
						        StrokeShape="RoundRectangle 14"
						        StrokeThickness="1">
							<HorizontalStackLayout Spacing="6" VerticalOptions="Center">
								<Label Text="{Binding Name}" FontSize="14" VerticalOptions="Center" />
								<!--
									Bound through the page rather than the item: the
									template's context is the Recipient, and the command
									lives on the view model. x:Reference rather than a
									relative source, because this project compiles its
									bindings and a reference is the form that always
									compiles.
								-->
								<Button Text="×"
								        FontSize="16"
								        Padding="0"
								        WidthRequest="26"
								        HeightRequest="26"
								        BackgroundColor="Transparent"
								        VerticalOptions="Center"
								        SemanticProperties.Description="Remove recipient"
								        Command="{Binding Source={x:Reference Page}, Path=BindingContext.DropCommand}"
								        CommandParameter="{Binding .}" />
							</HorizontalStackLayout>
						</Border>
					</DataTemplate>
				</BindableLayout.ItemTemplate>
			</FlexLayout>

			<Label Style="{StaticResource Secondary}"
			       IsVisible="{Binding HasChosenNothing}"
			       Text="Nobody chosen yet. Tap a name or a committee below." />

			<!--
				Filters the list already in hand rather than asking Fellowship
				again. Hand searches server-side because its member list is
				paged; Link is handed the whole address book in one response,
				so a round trip per keystroke would buy nothing and cost a
				request.
			-->
			<SearchBar
				Text="{Binding Search}"
				Placeholder="Search by name, group, position or committee" />

			<CollectionView
				x:Name="CandidateList"
				ItemsSource="{Binding Candidates}"
				SelectionMode="Single"
				SelectionChangedCommand="{Binding ChooseCommand}"
				SelectionChangedCommandParameter="{Binding Source={x:Reference CandidateList}, Path=SelectedItem}"
				HeightRequest="240">
				<CollectionView.EmptyView>
					<Label Style="{StaticResource Secondary}"
					       Text="No one left to show. Pull the message list down to reconnect." />
				</CollectionView.EmptyView>
				<CollectionView.ItemTemplate>
					<DataTemplate x:DataType="models:Recipient">
						<!--
							Hand's two-line row, and Hand's reason for it: a rota
							has more than one Dave, and what tells them apart is
							the home group. Where Hand puts a "Show number" button
							and the numbers it fetches, this puts the member's
							standing and nothing else: Link is never told an email
							address or a telephone number, so there is nothing to
							reveal and no button to press.
						-->
						<VerticalStackLayout Padding="12,10" Spacing="2">
							<Label Text="{Binding Name}" FontSize="16" />
							<Label Text="{Binding Detail}"
							       IsVisible="{Binding HasDetail}"
							       FontSize="12"
							       Opacity="0.6" />
						</VerticalStackLayout>
					</DataTemplate>
				</CollectionView.ItemTemplate>
			</CollectionView>

			<Label Style="{StaticResource Secondary}"
			       Text="A committee includes its sub-committees." />

			<Entry Placeholder="Subject" Text="{Binding Subject}" MaxLength="200" />

			<Editor Placeholder="Message"
			        Text="{Binding Body}"
			        MaxLength="2000"
			        AutoSize="TextChanges"
			        HeightRequest="160" />

			<Label Style="{StaticResource Secondary}"
			       Text="Messages are encrypted before they leave your phone and are not shown in notifications." />

			<Button Text="Send" Command="{Binding SendCommand}" />

			<ActivityIndicator IsRunning="{Binding Busy}" IsVisible="{Binding Busy}" />

			<Label Text="{Binding Error}"
			       IsVisible="{Binding HasError}"
			       TextColor="{StaticResource Warning}" />

		</VerticalStackLayout>
	</ScrollView>

</ContentPage>
