<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:TheBleedingDeacons.Intergroup.Link.Models;assembly=TheBleedingDeacons.Intergroup.Link.Core"
             xmlns:vm="clr-namespace:TheBleedingDeacons.Intergroup.Link.ViewModels"
             x:Class="TheBleedingDeacons.Intergroup.Link.Views.MessagesPage"
             x:DataType="vm:MessagesViewModel"
             Title="Messages">

	<!--
		Laid out as Hand's duty screen is: a header line carrying the
		buttons, the list under it, nothing along the bottom.

		Buttons rather than ToolbarItems, and Hand's header settles it. A
		ToolbarItem is plain text drawn by the navigation bar: it cannot
		take the Button style, so it reads as a word in the corner while
		everything else a member can press in either app is a filled blue
		rectangle. The navigation bar is hidden in AppShell for the same
		reason, and Hand's AlertsPage carries a comment warning that a
		ToolbarItem on a page with no navigation bar renders nowhere at
		all - worth reading before anybody puts one back.
	-->
	<!--
		An outer single-cell Grid, holding the page and, over it, the ⋮
		dropdown. See the note beside MoreMenu at the bottom on why the
		menu cannot simply sit inside the rows below.
	-->
	<Grid>

	<Grid RowDefinitions="Auto,Auto,Auto,*">

		<!--
			Hand's status-line proportions: 18 bold, and the buttons as
			small as they can be while still being hit reliably. The
			shared style's 14,10 padding is for a button that owns its
			row; these sit beside a title.
		-->
		<Grid x:Name="Header"
		      Grid.Row="0"
		      ColumnDefinitions="*,Auto"
		      Padding="12,14"
		      ColumnSpacing="6">
			<Label Grid.Column="0"
			       Text="Messages"
			       FontSize="18"
			       FontAttributes="Bold"
			       VerticalOptions="Center" />

			<!--
				No New button here any more. Writing a message is the round
				send button floating at the bottom right (ComposeButton,
				below), where a thumb already is.
			-->

			<!--
				The overflow menu. One item today, Settings. Anything that is
				somewhere to go, rather than something to do, belongs in here
				and not as another button beside New.

				A dropdown drawn by this page (MoreMenu, at the bottom), not
				anything the platform supplies:
				- An action sheet was tried first. It opens as a dialog in
				  the middle of the screen, not dropping from the button.
				- A secondary ToolbarItem would get Android's own overflow,
				  but the navigation bar is hidden on this page, and a
				  toolbar item with no bar renders nowhere. See the comment
				  at the top of this page.
				- ContextFlyout is not implemented on Android or iOS.

				The TextColor is set explicitly on purpose. A transparent
				Button keeps the implicit style's TextColor, which is white:
				the colour for text on a filled button. The compose chips
				hit exactly that, a control that responds to a tap and draws
				nothing.
			-->
			<Button x:Name="MoreButton"
			        Grid.Column="1"
			        Text="&#x22EE;"
			        FontSize="24"
			        FontAttributes="Bold"
			        Padding="0"
			        WidthRequest="44"
			        BackgroundColor="Transparent"
			        TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}"
			        SemanticProperties.Description="More options"
			        Clicked="OnMoreClicked" />
		</Grid>

		<!--
			The member is looking at a list that is missing something, and
			without being told they would conclude the message was never
			sent. The recovery is on Settings.

			Rounded and inset like Hand's alert cards, because it is the
			same kind of thing: the one item on the screen that wants
			something doing.
		-->
		<Border Grid.Row="1"
		        Margin="12,0,12,6"
		        IsVisible="{Binding KeyFault}"
		        BackgroundColor="{StaticResource Warning}"
		        Padding="14"
		        StrokeThickness="0">
			<Border.StrokeShape>
				<RoundRectangle CornerRadius="14" />
			</Border.StrokeShape>
			<Label TextColor="White"
			       FontSize="14"
			       Text="Some messages could not be opened on this phone. Go to Settings and choose 'Fix messages that will not open'." />
		</Border>

		<!--
			Signed out, rather than merely out of signal. The same red as
			the key-fault banner above, because it is the same kind of
			thing: something the member has to act on, and the messages
			behind it are the last they will receive until they do.
		-->
		<Border Grid.Row="1"
		        Margin="12,0,12,6"
		        IsVisible="{Binding SignedOut}"
		        BackgroundColor="{StaticResource Warning}"
		        Padding="14"
		        StrokeThickness="0">
			<Border.StrokeShape>
				<RoundRectangle CornerRadius="14" />
			</Border.StrokeShape>
			<Label TextColor="White"
			       FontSize="14"
			       Text="{Binding SignedOutReason}" />
		</Border>

		<Label Grid.Row="2"
		       IsVisible="{Binding Offline}"
		       FontSize="13"
		       Opacity="0.6"
		       Padding="12,0,12,8"
		       Text="Showing messages saved on this phone — the intergroup could not be reached." />

		<RefreshView Grid.Row="3"
		             IsRefreshing="{Binding Busy}"
		             Command="{Binding RefreshCommand}">

			<CollectionView ItemsSource="{Binding Messages}"
			                SelectionMode="None">

				<!--
					Room under the last message for the floating compose
					button, so it can always be scrolled clear rather than
					sitting on top of the oldest row for good. BoxView with a
					transparent BackgroundColor as well as Color: the implicit
					style paints the background near-black.
				-->
				<CollectionView.Footer>
					<BoxView HeightRequest="88" Color="Transparent" BackgroundColor="Transparent" />
				</CollectionView.Footer>

				<!--
					Hand's "All clear": said large and faint rather than as
					a line of small print, because an empty screen is
					indistinguishable from one that has stopped working.
				-->
				<CollectionView.EmptyView>
					<VerticalStackLayout VerticalOptions="Center"
					                     HorizontalOptions="Center"
					                     Spacing="10"
					                     Padding="32">
						<Label Text="No messages"
						       FontSize="32"
						       HorizontalOptions="Center"
						       Opacity="0.55" />
						<Label Text="Pull down to check for new ones."
						       FontSize="14"
						       HorizontalTextAlignment="Center"
						       Opacity="0.55" />
					</VerticalStackLayout>
				</CollectionView.EmptyView>

				<CollectionView.ItemTemplate>
					<DataTemplate x:DataType="models:LinkMessage">
						<!--
							Hand's history row rather than a bordered card: a
							strip down the side and the text beside it, so a
							list reads as a shape before it reads as words.

							In Hand the strip is the alert's level. Link's
							messages have no level, so it carries unread
							instead - blue until opened, grey after. That is
							in addition to the weight below, not instead of
							it: weight survives sunlight and a member who
							cannot tell the two colours apart.
						-->
						<Grid Margin="12,5" ColumnDefinitions="6,*">

							<!--
								The command lives on the page's view model, not on the
								message, so this binding's x:DataType has to override the
								DataTemplate's. Without it the compiler resolves
								OpenCommand against LinkMessage, does not find it, and
								raises XC0045 - which is now an error.

								The whole row is the target, as it is in Hand: a
								subject line is not what somebody should have to hit.
							-->
							<Grid.GestureRecognizers>
								<TapGestureRecognizer
									Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MessagesViewModel}}, Path=OpenCommand, x:DataType=vm:MessagesViewModel}"
									CommandParameter="{Binding .}" />
							</Grid.GestureRecognizers>

							<!--
								BackgroundColor is set to Transparent on purpose. The
								implicit BoxView style paints BackgroundColor near-black,
								and CornerRadius rounds only Color, which is drawn on top.
								Left unset, the square background showed through at each
								rounded end as a dark cap. It was visible on a handset and
								nowhere in the XAML.
							-->
							<BoxView Grid.Column="0"
							         CornerRadius="3"
							         BackgroundColor="Transparent"
							         Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}">
								<BoxView.Triggers>
									<DataTrigger TargetType="BoxView" Binding="{Binding IsRead}" Value="False">
										<Setter Property="Color" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
									</DataTrigger>
								</BoxView.Triggers>
							</BoxView>

							<VerticalStackLayout Grid.Column="1" Padding="12,10" Spacing="4">

								<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
									<Label Grid.Column="0"
									       Text="{Binding Subject}"
									       FontSize="17"
									       LineBreakMode="TailTruncation">
										<Label.Triggers>
											<DataTrigger TargetType="Label" Binding="{Binding IsRead}" Value="False">
												<Setter Property="FontAttributes" Value="Bold" />
											</DataTrigger>
										</Label.Triggers>
									</Label>

									<Label Grid.Column="1"
									       FontSize="13"
									       Opacity="0.6"
									       VerticalOptions="Center"
									       Text="{Binding SentLocal, StringFormat='{0:d MMM, HH:mm}'}" />
								</Grid>

								<Label Text="{Binding Sender}"
								       FontSize="13"
								       Opacity="0.6" />

								<Label Text="{Binding Body}"
								       FontSize="15"
								       MaxLines="3"
								       LineBreakMode="TailTruncation" />

							</VerticalStackLayout>
						</Grid>
					</DataTemplate>
				</CollectionView.ItemTemplate>

			</CollectionView>

		</RefreshView>

	</Grid>

		<!--
			The compose button: small, round, floating at the bottom right,
			with a send icon. It replaced a text "New" button in the header.

			The icon is a vector Path rather than an image or a font glyph.
			Link ships no icon images and no icon font, and a missing image
			fails silently on Android (see AppShell.xaml on the tab icon that
			never existed). A Path needs nothing that has to exist. The data is
			the Material "send" paper plane.

			A Border with a tap rather than a Button, because a Button cannot
			hold a Path as its content. Drawn before the menu scrim below, so
			an open ⋮ menu covers it and a tap there closes the menu instead
			of opening compose. The list's footer leaves room under the last
			message so this never sits on top of one for good.
		-->
		<Border x:Name="ComposeButton"
		        HorizontalOptions="End"
		        VerticalOptions="End"
		        Margin="0,0,16,16"
		        WidthRequest="56"
		        HeightRequest="56"
		        StrokeThickness="0"
		        BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
		        SemanticProperties.Description="New message">
			<Border.StrokeShape>
				<RoundRectangle CornerRadius="28" />
			</Border.StrokeShape>
			<!--
				Shadow set explicitly. The implicit Shadow style is the
				template's white glow offset 10,10.
			-->
			<Border.Shadow>
				<Shadow Brush="Black" Opacity="0.3" Radius="10" Offset="0,4" />
			</Border.Shadow>
			<Border.GestureRecognizers>
				<TapGestureRecognizer Tapped="OnComposeTapped" />
			</Border.GestureRecognizers>

			<!--
				Nudged 2 right: the plane's weight is on its left, so centred
				by its bounds it looks off to one side.
			-->
			<Path Data="M2.01,21 L23,12 L2.01,3 L2,10 L17,12 L2,14 Z"
			      Fill="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}"
			      Aspect="Uniform"
			      WidthRequest="22"
			      HeightRequest="22"
			      Margin="2,0,0,0"
			      HorizontalOptions="Center"
			      VerticalOptions="Center" />
		</Border>

		<!--
			The ⋮ dropdown, and the layer that closes it.

			Siblings of the page's Grid, not children spanning its rows.
			They were children spanning the rows at first, and opening the
			menu pushed the whole page down a few pixels: a child spanning
			Auto rows counts towards their height, and the menu's top margin
			plus its own height made the Auto rows taller.

			Both come last so they draw on top. The page's code-behind
			opens and closes them together (ShowMenu) and places the menu
			under the button when it opens.

			The scrim is a BoxView with BackgroundColor made Transparent
			as well as Color, on purpose. The implicit BoxView style paints
			BackgroundColor near-black - the same thing that gave the
			message strips their dark corners - and left alone it would
			black out the whole page behind the menu.
		-->
		<BoxView x:Name="MenuScrim"
		         IsVisible="False"
		         Color="Transparent"
		         BackgroundColor="Transparent">
			<BoxView.GestureRecognizers>
				<TapGestureRecognizer Tapped="OnMenuScrimTapped" />
			</BoxView.GestureRecognizers>
		</BoxView>

		<!--
			Shadow set explicitly. The implicit Shadow style is the
			template's white glow offset 10,10, which reads as a smudge
			rather than as a menu lifted off the page.
		-->
		<Border x:Name="MoreMenu"
		        IsVisible="False"
		        HorizontalOptions="End"
		        VerticalOptions="Start"
		        MinimumWidthRequest="180"
		        Padding="0,6"
		        BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
		        Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
		        StrokeThickness="1">
			<Border.StrokeShape>
				<RoundRectangle CornerRadius="8" />
			</Border.StrokeShape>
			<Border.Shadow>
				<Shadow Brush="Black" Opacity="0.2" Radius="12" Offset="0,4" />
			</Border.Shadow>

			<VerticalStackLayout>
				<Grid Padding="16,12" SemanticProperties.Description="Settings">
					<Grid.GestureRecognizers>
						<TapGestureRecognizer Tapped="OnSettingsTapped" />
					</Grid.GestureRecognizers>
					<Label Text="Settings" FontSize="16" VerticalOptions="Center" />
				</Grid>
			</VerticalStackLayout>
		</Border>

	</Grid>

</ContentPage>
