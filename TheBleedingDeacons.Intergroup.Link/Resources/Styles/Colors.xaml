<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

	<!--
		A quiet palette on purpose. Link carries ordinary fellowship
		business, and an app that shouts is one people stop opening. Hand
		is the one that is allowed to be loud, and only because a helpline
		alert has to be.
	-->
	<Color x:Key="Primary">#2E5E4E</Color>
	<Color x:Key="PrimaryDark">#1E4034</Color>
	<Color x:Key="Accent">#C4A24C</Color>

	<Color x:Key="PageBackground">#FAFAF8</Color>
	<Color x:Key="PageBackgroundDark">#141614</Color>

	<Color x:Key="CardBackground">#FFFFFF</Color>
	<Color x:Key="CardBackgroundDark">#1F221F</Color>

	<Color x:Key="TextPrimary">#1A1C1A</Color>
	<Color x:Key="TextPrimaryDark">#F2F3F2</Color>

	<Color x:Key="TextSecondary">#5C625E</Color>
	<Color x:Key="TextSecondaryDark">#A6ADA8</Color>

	<Color x:Key="Divider">#E2E5E2</Color>
	<Color x:Key="DividerDark">#2C302D</Color>

	<Color x:Key="Warning">#B3261E</Color>

</ResourceDictionary>
