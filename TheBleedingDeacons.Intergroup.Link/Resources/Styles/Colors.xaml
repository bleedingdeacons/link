<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!--
        Fixed colours only. The ones that change with the member's style
        and the phone's light or dark - Primary, the page, the text - are
        not here: they are published at runtime as dynamic resources by
        ThemeChoice, from LinkPalette, and a page asks for them with
        {DynamicResource Primary}. A Primary defined here as well would
        sit under that one and be found by anything that asked for it
        statically, which would then never change.

        The splash is still #3977C3, set in the project file, so a
        member on the blue sees the same colour from launch onwards.
    -->

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="MidnightBlue">#190649</Color>
    <Color x:Key="OffBlack">#1f1f1f</Color>

    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>

    <!--
        Link's own, on top of Hand's palette above rather than beside it.

        The suite green survives as an accent and as the app icon, which is
        what tells Link from Hand in a launcher. Everything that carries
        meaning - the primary, the text, the surfaces - is now Hand's, so a
        member holding both apps is not learning two colour languages.

        Warning is Hand's alert red, and is used the same way: for the line
        that says something did not work, never for ordinary chrome.
    -->
    <Color x:Key="Accent">#2E5E4E</Color>
    <Color x:Key="Warning">#B3261E</Color>
</ResourceDictionary>
