    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="BackgroundColor" Value="{DynamicResource PageBackground}" />
    </Style>

    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{DynamicResource PageBackground}" />
        <Setter Property="Shell.ForegroundColor" Value="{DynamicResource Primary}" />
        <Setter Property="Shell.TitleColor" Value="{DynamicResource TextPrimary}" />
        <Setter Property="Shell.DisabledColor" Value="{DynamicResource Separator}" />
        <Setter Property="Shell.UnselectedColor" Value="{DynamicResource TextSecondary}" />
        <Setter Property="Shell.NavBarHasShadow" Value="False" />
        <Setter Property="Shell.TabBarBackgroundColor" Value="{DynamicResource PageBackground}" />
        <!--
            Primary, not the template's Magenta. Link no longer has a tab
            bar - it went so the shell matches Hand's, which never had one -
            but these stay Primary so that if one ever comes back it does
            not arrive in an accent colour that appears nowhere else.
        -->
        <Setter Property="Shell.TabBarForegroundColor" Value="{DynamicResource Primary}" />
        <Setter Property="Shell.TabBarTitleColor" Value="{DynamicResource Primary}" />
        <Setter Property="Shell.TabBarUnselectedColor" Value="{DynamicResource TextSecondary}" />
    </Style>

    <Style TargetType="NavigationPage">
        <Setter Property="BarBackgroundColor" Value="{DynamicResource PageBackground}" />
        <Setter Property="BarTextColor" Value="{DynamicResource TextPrimary}" />
        <Setter Property="IconColor" Value="{DynamicResource TextPrimary}" />
    </Style>

    <Style TargetType="TabbedPage">
        <Setter Property="BarBackgroundColor" Value="{DynamicResource PageBackground}" />
        <Setter Property="BarTextColor" Value="{DynamicResource Primary}" />
        <Setter Property="UnselectedTabColor" Value="{DynamicResource TextSecondary}" />
        <Setter Property="SelectedTabColor" Value="{DynamicResource Primary}" />
    </Style>


    <!--
        Link's one named style. Everything else on a Link page takes the
        implicit styles above, which are Hand's, unmodified - and sizes and
        faintness are set on the page, as Hand sets them, rather than
        through named text styles.

        There were four. Secondary, Heading and Card went when the pages
        were laid out as Hand's are: Hand has no bordered cards and no
        heading style, and its quiet text is a size and an opacity on the
        label itself. A page written against those styles looked like a
        cousin of Hand's rather than the same app family.

        Quiet stays because Hand has the same thing, only inline: the
        outlined buttons on an alert card. It is for the way out of a
        side-track - Cancel, or opening the set-password section - and
        never for an action. Actions are filled, as in Hand.
    -->
    <Style TargetType="Button" x:Key="Quiet">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{DynamicResource Primary}" />
        <Setter Property="BorderColor" Value="{DynamicResource Separator}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="FontFamily" Value="{DynamicResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource SecondaryFontSize}" />
        <Setter Property="CornerRadius" Value="{DynamicResource ButtonCornerRadius}" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="HeightRequest" Value="44" />
    </Style>

</ResourceDictionary>
