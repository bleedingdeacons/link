<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

	<Style TargetType="ContentPage" ApplyToDerivedTypes="True">
		<Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}" />
		<Setter Property="Padding" Value="0" />
	</Style>

	<Style TargetType="Label">
		<Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
		<Setter Property="FontSize" Value="15" />
	</Style>

	<Style x:Key="Secondary" TargetType="Label">
		<Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
		<Setter Property="FontSize" Value="13" />
	</Style>

	<Style x:Key="Heading" TargetType="Label">
		<Setter Property="FontSize" Value="22" />
		<Setter Property="FontAttributes" Value="Bold" />
	</Style>

	<Style TargetType="Button">
		<Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
		<Setter Property="TextColor" Value="#FFFFFF" />
		<Setter Property="CornerRadius" Value="8" />
		<Setter Property="Padding" Value="20,12" />
		<Setter Property="FontSize" Value="16" />
	</Style>

	<Style x:Key="Quiet" TargetType="Button">
		<Setter Property="BackgroundColor" Value="Transparent" />
		<Setter Property="TextColor" Value="{StaticResource Primary}" />
		<Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource Divider}, Dark={StaticResource DividerDark}}" />
		<Setter Property="BorderWidth" Value="1" />
		<Setter Property="CornerRadius" Value="8" />
	</Style>

	<Style x:Key="Card" TargetType="Border">
		<Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}" />
		<Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Divider}, Dark={StaticResource DividerDark}}" />
		<Setter Property="StrokeThickness" Value="1" />
		<Setter Property="Padding" Value="14" />
	</Style>

	<Style TargetType="Entry">
		<Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
	</Style>

	<Style TargetType="Editor">
		<Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
	</Style>

	<Style TargetType="Shell" ApplyToDerivedTypes="True">
		<Setter Property="Shell.BackgroundColor" Value="{StaticResource Primary}" />
		<Setter Property="Shell.ForegroundColor" Value="#FFFFFF" />
		<Setter Property="Shell.TitleColor" Value="#FFFFFF" />
		<Setter Property="Shell.TabBarBackgroundColor" Value="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}" />
		<Setter Property="Shell.TabBarTitleColor" Value="{StaticResource Primary}" />
	</Style>

</ResourceDictionary>
